  "$id": "urn:cap:core:order-query-result:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/SerializedComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "contract_version": {
      "const": "core.order-query.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "equipment": {
      "items": {
        "$ref": "#/$defs/Equipment"
      },
      "title": "Equipment",
      "type": "array"
    },
    "lots": {
