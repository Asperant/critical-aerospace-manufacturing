        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "Equipment",
      "type": "object"
    },
    "Lot": {
      "additionalProperties": false,
