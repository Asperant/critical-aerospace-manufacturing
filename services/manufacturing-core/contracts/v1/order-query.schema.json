        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "order_id": {
          "pattern": "\\S",
          "title": "Order Id",
          "type": "string"
        },
        "revision": {
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "order_id"
      ],
      "title": "Lot",
      "type": "object"
    },
    "ManufacturingRoute": {
