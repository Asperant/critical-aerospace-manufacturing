        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        },
        "route_id": {
          "pattern": "\\S",
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "route_id"
      ],
      "title": "ProductionOrder",
      "type": "object"
    },
    "RouteVisit": {
      "additionalProperties": false,
      "properties": {
        "equipment_id": {
          "pattern": "\\S",
          "title": "Equipment Id",
          "type": "string"
        },
        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "operation_class_id": {
          "pattern": "\\S",
          "title": "Operation Class Id",
          "type": "string"
        },
        "revision": {
          "pattern": "\\S",
          "title": "Revision",
          "type": "string"
        },
        "route_id": {
          "pattern": "\\S",
          "title": "Route Id",
          "type": "string"
