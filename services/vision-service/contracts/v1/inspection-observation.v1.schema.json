{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cap:vision:inspection-observation:v1",
  "title": "InspectionObservation.v1 payload (EVT-InspectionObservation-v1)",
  "description": "Immutable Vision/NDT perception evidence for one inspection artifact (WP-VIS-001; FR-VIS-001, FR-VIS-009). Distinct from the Core-normalized IC-VIS-002 InspectionResult: an observation reports defect candidates with uncertainty and provenance, never a quality disposition, hold, root cause or acceptance. Envelope metadata is validated by cap event-envelope.v1 (WP-EVT-002).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type", "schema_version", "observation_id", "inspection_request_id", "inspection_run_id",
    "subject", "context", "source_artifact", "outcome", "review_required", "data_quality",
    "defects", "image_anomaly_score", "confidence_calibration", "pipeline_identity", "inference"
  ],
  "properties": {
    "event_type": {"const": "vision.inspection-observation"},
    "schema_version": {"const": 1},
    "observation_id": {
      "description": "Identity of this immutable observation. A re-run or a human review is a new observation, never an edit.",
      "$ref": "#/$defs/uuid"
    },
    "inspection_request_id": {
      "description": "IC-VIS-001 InspectionRequest identity that triggered the run; opaque.",
      "$ref": "#/$defs/opaque_id"
    },
    "inspection_run_id": {"$ref": "#/$defs/opaque_id"},
    "subject": {
      "description": "Core identities consumed from core.order-query.v1 (Lot, SerializedComponent, RouteVisit). Values and revisions are opaque Core strings, preserved unchanged; the revision is the one named by the request, not a freshness proof.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id", "lot_revision", "serialized_component_id", "serialized_component_revision", "route_visit_id"
      ],
      "properties": {
        "lot_id": {"$ref": "#/$defs/opaque_id"},
        "lot_revision": {"$ref": "#/$defs/opaque_id"},
        "serialized_component_id": {"$ref": "#/$defs/opaque_id"},
        "serialized_component_revision": {"$ref": "#/$defs/opaque_id"},
        "route_visit_id": {
          "description": "Route visit at which the inspection ran. Distinct visits keep a re-entrant reinspection distinguishable from the first inspection.",
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "context": {
      "description": "World and run context, mirroring cap.artifact-ref/v1 context. world_id is always explicit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["world_id", "simulation_run_id", "branch_id"],
      "properties": {
        "world_id": {"$ref": "#/$defs/opaque_id"},
        "simulation_run_id": {"$ref": "#/$defs/optional_id"},
        "branch_id": {"$ref": "#/$defs/optional_id"}
      }
    },
    "source_artifact": {
      "description": "Identity of the inspected image version (cap.artifact-ref/v1). Never bytes, a bucket/key or a signed URL.",
      "$ref": "#/$defs/artifact_identity"
    },
    "outcome": {
      "description": "Perception outcome only. NOT_EVALUATED is used when the input could not be evaluated; Vision never substitutes a success-shaped NO_DEFECT_CANDIDATES.",
      "enum": ["DEFECT_CANDIDATES", "NO_DEFECT_CANDIDATES", "NOT_EVALUATED"]
    },
    "review_required": {
      "description": "True when any candidate is not a confident known-class detection, or the producer requests human review for another recorded reason.",
      "type": "boolean"
    },
    "data_quality": {
      "description": "Input quality (02 VIS-E9). A non-VALID status names at least one flag.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "flags"],
      "properties": {
        "status": {"enum": ["VALID", "DEGRADED_INPUT", "INVALID_INPUT"]},
        "flags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
        }
      },
      "if": {"properties": {"status": {"const": "VALID"}}},
      "then": {"properties": {"flags": {"maxItems": 0}}},
      "else": {"properties": {"flags": {"minItems": 1}}}
    },
    "defects": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/defect_candidate"}
    },
    "image_anomaly_score": {
      "description": "Image-level open-set anomaly score from a path independent of the closed-set classifier; null when no anomaly path ran.",
      "type": ["number", "null"],
      "minimum": 0
    },
    "confidence_calibration": {
      "description": "Whether reported confidences are calibrated (on the CAL partition, WP-VIS-005). UNCALIBRATED confidences are raw model scores.",
      "enum": ["UNCALIBRATED", "CALIBRATED"]
    },
    "pipeline_identity": {
      "description": "Evaluated pipeline identity (02 VIS-E11): ModelVersion + PreprocessingVersion + ThresholdPolicyVersion + OutputSchemaVersion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "preprocessing_version", "threshold_policy_version", "output_schema_version"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "model_package_id", "model_version"],
            "properties": {
              "task": {
                "description": "BASELINE_ALGORITHM is a simple generic algorithm permitted before promoted ModelPackages exist (05 DEP-059, F2).",
                "enum": [
                  "CLASSIFICATION", "LOCALIZATION", "SEGMENTATION", "ANOMALY_DETECTION", "BASELINE_ALGORITHM"
                ]
              },
              "model_package_id": {"$ref": "#/$defs/opaque_id"},
              "model_version": {"$ref": "#/$defs/opaque_id"}
            }
          }
        },
        "preprocessing_version": {"$ref": "#/$defs/opaque_id"},
        "threshold_policy_version": {"$ref": "#/$defs/opaque_id"},
        "output_schema_version": {"const": "vision.inspection-observation.v1"}
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "latency_ms"],
      "properties": {
        "started_at": {"$ref": "#/$defs/instant"},
        "completed_at": {"$ref": "#/$defs/instant"},
        "latency_ms": {"type": "number", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "DEFECT_CANDIDATES"}}},
      "then": {"properties": {"defects": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "NO_DEFECT_CANDIDATES"}}},
      "then": {"properties": {"defects": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "NOT_EVALUATED"}}},
      "then": {
        "properties": {
          "defects": {"maxItems": 0},
          "image_anomaly_score": {"type": "null"},
          "data_quality": {"properties": {"status": {"const": "INVALID_INPUT"}}}
        }
      }
    },
    {
      "if": {"properties": {"data_quality": {"properties": {"status": {"const": "INVALID_INPUT"}}}}},
      "then": {"properties": {"outcome": {"const": "NOT_EVALUATED"}}}
    },
    {
      "if": {
        "properties": {
          "defects": {
            "contains": {
              "properties": {"open_set_decision": {"not": {"const": "KNOWN_CLASS"}}}
            }
          }
        }
      },
      "then": {"properties": {"review_required": {"const": true}}}
    }
  ],
  "$defs": {
    "defect_candidate": {
      "description": "One perceived defect candidate. Decision names avoid ACCEPTED: Vision never performs quality acceptance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defect_id", "open_set_decision", "class_label", "class_confidence", "anomaly_score",
        "localization", "mask_artifact", "area_fraction"
      ],
      "properties": {
        "defect_id": {
          "description": "Unique within the observation.",
          "$ref": "#/$defs/opaque_id"
        },
        "open_set_decision": {
          "description": "02 open-set rule outcome: KNOWN_CLASS (high known-class confidence, low anomaly), KNOWN_CLASS_REVIEW_REQUIRED (known-class fit questioned by high anomaly), UNKNOWN_REVIEW_REQUIRED (open-set novel sample), LOW_CONFIDENCE_REVIEW (selective-prediction review band).",
          "enum": [
            "KNOWN_CLASS", "KNOWN_CLASS_REVIEW_REQUIRED", "UNKNOWN_REVIEW_REQUIRED", "LOW_CONFIDENCE_REVIEW"
          ]
        },
        "class_label": {
          "description": "Known-class label; null exactly when the candidate is UNKNOWN. Taxonomy names are not frozen by this contract.",
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "class_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "anomaly_score": {"type": ["number", "null"], "minimum": 0},
        "localization": {
          "description": "Axis-aligned box in image-normalized coordinates, origin top-left; null when the candidate is not localized.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "frame", "x", "y", "width", "height"],
              "properties": {
                "kind": {"const": "BBOX"},
                "frame": {"const": "IMAGE_NORMALIZED"},
                "x": {"type": "number", "minimum": 0, "maximum": 1},
                "y": {"type": "number", "minimum": 0, "maximum": 1},
                "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            }
          ]
        },
        "mask_artifact": {
          "description": "Segmentation mask stored as its own artifact version; null when no mask was produced.",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_identity"}]
        },
        "area_fraction": {
          "description": "Defect area as a fraction of the image; null when not measured.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      },
      "if": {"properties": {"open_set_decision": {"const": "UNKNOWN_REVIEW_REQUIRED"}}},
      "then": {"properties": {"class_label": {"type": "null"}}},
      "else": {"properties": {"class_label": {"type": "string"}}}
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_schema", "artifact_id", "version", "artifact_type", "checksum"],
      "properties": {
        "ref_schema": {"const": "cap.artifact-ref/v1"},
        "artifact_id": {"$ref": "#/$defs/uuid"},
        "version": {"type": "integer", "minimum": 1},
        "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"enum": ["sha256"]},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "opaque_id": {"type": "string", "pattern": "^\\S+$", "maxLength": 128},
    "optional_id": {"type": ["string", "null"], "pattern": "^\\S+$", "maxLength": 128},
    "instant": {
      "description": "UTC RFC 3339 instant.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
