{
  "include": [
    "tools",
    "ci",
    "packages/contracts/src",
    "services/manufacturing-simulator/src",
    "services/manufacturing-simulator/tests"
  ],
  "exclude": ["**/.venv", "**/__pycache__"],
  "pythonVersion": "3.11",
  "typeCheckingMode": "standard",
  "strict": ["ci"],
  "reportMissingModuleSource": "none",
  "executionEnvironments": [
    {"root": "ci", "extraPaths": ["ci", "ci/scripts", "ci/tests", "packages/contracts/src"]},
    {"root": "tools/trace", "extraPaths": ["tools/trace/src"]},
    {
      "root": "services/manufacturing-simulator",
      "extraPaths": [
        "services/manufacturing-simulator/src",
        "services/manufacturing-simulator/tests"
      ]
    }
  ]
}
