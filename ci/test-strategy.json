{
  "schema": "cap.test-strategy/v1",
  "boundary_modes": ["REAL", "FIXTURE_ALLOWED", "STUB_ALLOWED", "MOCK_ONLY"],
  "tiers": [
    {"name": "unit", "purpose": "one module or package in isolation; no network, no containers", "ci_job": "unit", "budget_s": 600, "boundary_modes": ["FIXTURE_ALLOWED", "STUB_ALLOWED", "MOCK_ONLY"]},
    {"name": "component", "purpose": "one deployable through its own interfaces, external boundaries replaced", "ci_job": "unit", "budget_s": 600, "boundary_modes": ["FIXTURE_ALLOWED", "STUB_ALLOWED"]},
    {"name": "contract", "purpose": "published schemas, examples and API contracts against their consumers' expectations", "ci_job": "contract", "budget_s": 300, "boundary_modes": ["REAL", "FIXTURE_ALLOWED"]},
    {"name": "integration", "purpose": "real infrastructure (PostgreSQL, NATS JetStream, Collector, OpenObserve, Compose profiles) and real processes", "ci_job": "integration", "budget_s": 1200, "boundary_modes": ["REAL", "FIXTURE_ALLOWED"]},
    {"name": "scenario", "purpose": "integrated acceptance paths (E2E-*, AV-SCEN-*) across deployables", "ci_job": null, "budget_s": 3600, "boundary_modes": ["REAL"]},
    {"name": "benchmark", "purpose": "measurements against NFR thresholds on a documented HardwareProfile; run on request, never a pass/fail gate by retry", "ci_job": null, "budget_s": 3600, "boundary_modes": ["REAL"]}
  ],
  "test_id": {
    "pattern": "^TEST-[A-Z]+-[0-9]{3}-[0-9]{3}$",
    "rule": "TEST-<AREA>-<NNN>-<SSS>: AREA-NNN is the producing work package WP-<AREA>-<NNN>, SSS a sequence within it; each concrete asset names its 03 planned family",
    "legacy": ["TEST-CICD-001", "TEST-CICD-002", "TEST-CICD-003"]
  },
  "suites": [
    {"path": "ci/tests", "owner": "Yavuz", "work_package": "WP-CICD-001", "families": ["TEST-DX-FLAKE"], "test_ids": ["TEST-CICD-001", "TEST-CICD-002", "TEST-TEST-001-001"],
     "runs": [{"tier": "unit", "boundary_mode": "FIXTURE_ALLOWED", "ci_step": "CI tooling tests"}]},
    {"path": "ci/tests/test_architecture_boundaries.py", "owner": "Asrın", "work_package": "WP-EVT-005", "families": ["TEST-ARCH-BOUNDARY"], "test_ids": ["TEST-EVT-005-001"],
     "runs": [{"tier": "unit", "boundary_mode": "FIXTURE_ALLOWED", "ci_step": "CI tooling tests"}]},
    {"path": "ci/tests/test_wp_test_002_contract_suite.py", "owner": "Asrın", "work_package": "WP-TEST-002", "families": ["TEST-DATA-CONTRACTVALID", "TEST-EVT-SCHEMA"], "test_ids": ["TEST-TEST-002-001"],
     "runs": [{"tier": "unit", "boundary_mode": "FIXTURE_ALLOWED", "ci_step": "CI tooling tests"}]},
    {"path": "ci/tests/test_ai_tool_contract.py", "owner": "Asrın", "work_package": "WP-AI-002", "families": ["TEST-AI-TOOLS"], "test_ids": ["TEST-AI-002-001"],
     "runs": [{"tier": "unit", "boundary_mode": "FIXTURE_ALLOWED", "ci_step": "CI tooling tests"}]},
    {"path": "ci/integration", "owner": "Yavuz", "work_package": "WP-CICD-001", "families": [], "family_note": "integration-tier gate integrity (03 §19.2: no planned family)", "test_ids": ["TEST-CICD-003"],
     "runs": [{"tier": "integration", "boundary_mode": "REAL", "ci_step": "Integration smoke (boundary mode REAL)"}]},
    {"path": "packages/observability/tests", "owner": "Yavuz", "work_package": "WP-OBS-001", "families": ["TEST-OBS-LOGS", "TEST-OBS-HEALTH"], "test_ids": ["TEST-OBS-001-001", "TEST-OBS-001-003", "TEST-OBS-001-004"],
     "runs": [{"tier": "unit", "boundary_mode": "FIXTURE_ALLOWED", "ci_step": "Observability standard tests and typing (WP-OBS-001)"}]},
    {"path": "packages/artifacts/tests", "owner": "Yavuz", "work_package": "WP-OBJ-001", "families": ["TEST-DATA-CHECKSUM"], "test_ids": ["TEST-OBJ-001-001", "TEST-OBJ-001-002", "TEST-OBJ-001-003", "TEST-OBJ-001-004", "TEST-OBJ-001-005", "TEST-OBJ-001-006", "TEST-OBJ-001-007"],
     "runs": [{"tier": "unit", "boundary_mode": "STUB_ALLOWED", "ci_step": "Artifact reference contract tests and typing (WP-OBJ-001)"},
              {"tier": "integration", "boundary_mode": "REAL", "ci_step": "Artifact store tests (REAL SeaweedFS, WP-OBJ-001)"}]},
    {"path": "infra/observability/tests", "owner": "Yavuz", "work_package": "WP-OBS-001", "families": ["TEST-OBS-TELEMETRY"], "test_ids": ["TEST-OBS-001-002"],
     "runs": [{"tier": "unit", "boundary_mode": "FIXTURE_ALLOWED", "ci_step": "Observability standard tests and typing (WP-OBS-001)"},
              {"tier": "integration", "boundary_mode": "REAL", "ci_step": "Telemetry pipeline smoke (boundary mode REAL)"}]},
