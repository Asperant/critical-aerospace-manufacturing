{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cap.test-strategy/v1",
  "title": "Test strategy, tiers and boundary-mode policy (WP-TEST-001)",
  "description": "What is tested where, which boundaries must be REAL, and how tests are identified. ci/scripts/check_test_strategy.py enforces it against the repository and the CI workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "boundary_modes", "tiers", "test_id", "suites"],
  "properties": {
    "schema": {"const": "cap.test-strategy/v1"},
    "boundary_modes": {"type": "array", "items": {"$ref": "#/$defs/mode"}, "minItems": 4, "uniqueItems": true},
    "tiers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "purpose", "ci_job", "budget_s", "boundary_modes"],
        "properties": {
          "name": {"enum": ["unit", "component", "contract", "integration", "scenario", "benchmark"]},
          "purpose": {"type": "string", "minLength": 1},
          "ci_job": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*$"},
          "budget_s": {"type": "integer", "minimum": 1},
          "boundary_modes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mode"}}
        }
      }
    },
    "test_id": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern", "rule", "legacy"],
      "properties": {
        "pattern": {"type": "string"},
        "rule": {"type": "string"},
        "legacy": {"type": "array", "items": {"type": "string", "pattern": "^TEST-[A-Z]+-[0-9]{3}$"}}
      }
    },
    "suites": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "owner", "work_package", "families", "test_ids", "runs"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"},
          "owner": {"enum": ["Asrın", "Selman", "Batu", "Yavuz"]},
          "work_package": {"type": ["string", "null"], "pattern": "^WP-[A-Z]+-[0-9]{3}$"},
          "families": {"type": "array", "items": {"type": "string", "pattern": "^(TEST|BENCH|INSP|RES|AV|DEMO|E2E)-[A-Z0-9-]+$"}},
          "family_note": {"type": "string", "minLength": 1},
          "test_ids": {"type": "array", "items": {"type": "string"}},
          "runs": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["tier", "boundary_mode", "ci_step"],
              "properties": {
                "tier": {"enum": ["unit", "component", "contract", "integration", "scenario", "benchmark"]},
                "boundary_mode": {"$ref": "#/$defs/mode"},
                "ci_step": {"type": ["string", "null"], "minLength": 1},
                "on_request": {"type": "string", "minLength": 1},
                "fixture_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {"mode": {"enum": ["REAL", "FIXTURE_ALLOWED", "STUB_ALLOWED", "MOCK_ONLY"]}}
}
