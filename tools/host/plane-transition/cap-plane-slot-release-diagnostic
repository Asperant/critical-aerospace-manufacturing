#!/bin/sh
set -eu
if [ "$#" -ne 2 ]; then
    printf '%s\n' '{"status":"UNAVAILABLE","reason":"INVALID_ARGUMENTS"}'
    exit 2
fi
case "$1" in asrin|selman|batuhan|yavuz) ;; *) exit 2 ;; esac
case "$2" in WP-[A-Z0-9]*-[0-9][0-9][0-9]) ;; *) exit 2 ;; esac
exec /usr/bin/sudo -n /usr/bin/python3 -I /usr/local/libexec/cap-plane-slot-release-diagnostic.py "$1" "$2"
