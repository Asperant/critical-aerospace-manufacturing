#!/bin/sh
# Admin scope requires a real root invocation; own scope is checked against SUDO_UID.
if [ "$(id -u)" -eq 0 ]; then
    case "$*" in
        --all|"--all --json") exec /usr/bin/env -u SUDO_UID -u SUDO_USER -u SUDO_GID /usr/bin/python3 -I /usr/local/libexec/cap-plane-health.py "$@" ;;
        *) exit 2 ;;
    esac
fi
case "${CAP_PROFILE-}" in asrin|selman|batuhan|yavuz) ;; *) exit 2 ;; esac
case "$*" in
    "") exec /usr/bin/sudo -n /usr/bin/python3 -I /usr/local/libexec/cap-plane-health.py "$CAP_PROFILE" ;;
    --json) exec /usr/bin/sudo -n /usr/bin/python3 -I /usr/local/libexec/cap-plane-health.py "$CAP_PROFILE" --json ;;
    *) exit 2 ;;
esac
