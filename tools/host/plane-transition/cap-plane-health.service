[Unit]
Description=Read-only canonical project preparation health snapshot

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=cap-plane-health
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -I /usr/local/libexec/cap-plane-health-snapshot.py
TimeoutStartSec=240
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cap-plane-health /run
StandardOutput=journal
StandardError=null
