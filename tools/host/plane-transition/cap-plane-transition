#!/bin/sh
# Trusted-team operational guard; CAP_PROFILE is not an authentication boundary.
if [ "$#" -ne 2 ]; then
    printf '%s\n' '{"result":"DENIED","reason_code":"EXPECTED_WP_ID_AND_TARGET_STATE"}'
    exit 2
fi
case "${CAP_PROFILE-}" in
    asrin|selman|batuhan|yavuz) ;;
    *) printf '%s\n' '{"result":"DENIED","reason_code":"INVALID_CAP_PROFILE"}'; exit 2 ;;
esac
if ! /usr/bin/expr "$1" : 'WP-[A-Z0-9][A-Z0-9]*-[0-9][0-9][0-9]$' >/dev/null; then
    printf '%s\n' '{"result":"DENIED","reason_code":"INVALID_CANONICAL_WP_ID"}'
    exit 2
fi
case "$2" in
    BACKLOG|READY|IN_PROGRESS|IN_REVIEW|MERGE_READY|MERGED|VALIDATING|DONE|CANCELED|BLOCKED|UNBLOCKED) ;;
    *) printf '%s\n' '{"result":"DENIED","reason_code":"INVALID_TARGET_STATE"}'; exit 2 ;;
esac
exec /usr/bin/sudo -n /usr/local/libexec/cap-plane-transition "$CAP_PROFILE" "$1" "$2"
